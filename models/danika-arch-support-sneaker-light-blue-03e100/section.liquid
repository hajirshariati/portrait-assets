        if (this.openIndex < 0) this.applyCamera({ orbit: cfg.hero.orbit, target: cfg.hero.target, fov: cfg.hero.fov });
        this.emit('pv:manifest', { url, model: cfg.model.src });
      }).catch(() => { if (this.ctl) this.onError(); });
    }

    setupModelViewer() {
      if (!this.mv) return;
