        // 1.09 and sit there, which is what put an oversized disc under the middle pill.
        const pos = { x: -100, s: 0 };
        const paint = () => { el.style.transform = 'translateX(' + pos.x + 'px) scale(' + Math.max(0, pos.s) + ')'; };
        paint();
        introTw.run('introX', { from: -100, to: 0, spring: SPRING_RING, duration: 400, delay: 200, eps: 0.05, update: v => { pos.x = v; paint(); } });
        introTw.run('introScale', { from: 0, to: 1, spring: SPRING_RING, duration: 400, delay: 400, eps: 0.002, update: v => { pos.s = v; paint(); } });
        introTw.run('introRing', { from: 0, to: 1.008, spring: SPRING_RING, duration: 600, delay: 400, eps: 0.002, update: v => el.style.setProperty('--pe-scale', String(Math.max(0, v))) });
      }
      for (const it of items) { setInline(it.bg, { opacity: '0' }); setInline(it.label, { opacity: '0' }); }
      let longest = 600;
      this.later(() => {
        if (this.introState !== 'running') return;
        midItem.bgWrap.classList.add('grow-right'); setInline(midItem.bg, { opacity: '1', width: PILL + 'px' });
        // The circle's job ends the instant the middle pill draws its own background at the same size and
        // place. Apple hides it outright here (the centre tween's onStart sets display:none) - the pill is
        // translucent, so a solid circle left behind it darkens that end of the pill, which is exactly what
        // it used to do for the two seconds until finishIntro.
        if (el) { for (const k of ['introX', 'introScale', 'introRing']) { const t = introTw.map.get(k); if (t) { t.stop(); introTw.map.delete(k); } } el.classList.remove('is-on'); setInline(el, { opacity: '', transform: '' }); }
        introTw.run('introBgW' + mid, { from: PILL, to: midItem.buttonW, spring: SPRING_CARD, duration: 600, update: v => { midItem.bg.style.width = v + 'px'; } });
        introTw.run('introLbl' + mid, { from: 0, to: 1, ease: EASE.easeIn, duration: 250, delay: 250, eps: 0.001, update: v => { midItem.label.style.opacity = String(v); } });
        // Apple walks each side of the middle outwards with its own stagger index starting at zero, and the
        // two sides come from opposite directions: the pills above the middle rise from +35, the ones below
        // drop from -35, so the row springs apart from the centre. Stagger, durations and delays are
        // PANE_PARAMS.intro verbatim (width .8/.05, opacity .2 delay .1, scale .5 over .8/.05, y 35 over 1
        // delay .05, label opacity .4 delay .2/.04, label y 7 over .2 delay .16/.02).
        let blurAt = 0;
        for (let i = 1; i < items.length; i++) {
          for (const j of [mid - i, mid + i]) {
            const it = items[j]; if (!it) continue;
            const n = i - 1, up = j < mid, dy = up ? 35 : -35, ly = up ? 7 : -7;
            it.bgWrap.classList.add('grow-right'); setInline(it.bg, { width: PILL + 'px' });
            const st = { w: PILL, s: 0.5, y: dy };
            const paint = () => { it.bg.style.width = st.w + 'px'; it.bg.style.transform = 'translateY(' + st.y + 'px) scale(' + st.s + ')'; };
            paint();
            introTw.run('introBgW' + j, { from: PILL, to: it.buttonW, spring: SPRING_CARD, duration: 800, delay: n * 50, update: v => { st.w = v; paint(); } });
            introTw.run('introBgO' + j, { from: 0, to: 1, ease: EASE.linear, duration: 200, delay: 100, eps: 0.001, update: v => { it.bg.style.opacity = String(v); } });
            introTw.run('introBgS' + j, { from: 0.5, to: 1, spring: SPRING_CARD, duration: 800, delay: n * 50, eps: 0.002, update: v => { st.s = v; paint(); } });
            introTw.run('introBgY' + j, { from: dy, to: 0, spring: SPRING_CARD, duration: 1000, delay: 50, update: v => { st.y = v; paint(); } });
            introTw.run('introLbl' + j, { from: 0, to: 1, ease: EASE.easeIn, duration: 400, delay: 200 + n * 40, eps: 0.001, update: v => { it.label.style.opacity = String(v); } });
            introTw.run('introLblY' + j, { from: ly, to: 0, ease: EASE.easeIn, duration: 200, delay: 160 + n * 20, update: v => { it.label.style.transform = 'translateY(' + v + 'px)'; } });
            if (j === 0) blurAt = 160 + n * 20 + 200;
            longest = Math.max(longest, 1000 + 50 + n * 50);
          }
        }
        // The frosted-glass blur ramps in over the last second of the intro rather than snapping on at the
        // end: Apple tweens --blur-amount 0 -> 20px, eased in, once the outermost label has landed.
        introTw.run('introBlur', { from: 0, to: 20, ease: EASE.easeIn, duration: 1000, delay: blurAt, eps: 0.05, update: v => this.style.setProperty('--pv-blur', v.toFixed(2) + 'px') });
        longest = Math.max(longest, blurAt + 1000);
        this.later(() => this.finishIntro(), Math.min(longest + 100, 2000));
      }, 600);
    }
    finishIntro() {
      if (this.introState !== 'running') return; this.introState = 'done';
      for (const k of Array.from(this.tw.map.keys())) if (k.indexOf('intro') === 0) { const t = this.tw.map.get(k); t.stop(); this.tw.map.delete(k); }
      for (const it of this.items) { setInline(it.bg, { opacity: '', width: '', transform: '' }); setInline(it.label, { opacity: '', transform: '' }); it.bgWrap.classList.remove('grow-right'); }
      if (this.introEl) { this.introEl.classList.remove('is-on'); setInline(this.introEl, { opacity: '', transform: '' }); }
      this.style.removeProperty('--pv-blur'); this.classList.remove('is-intro');
      this.emit('pv:intro', { state: 'done' });
    }

    /* ---------------------------------------------------------------- public state */
    state() {
      let orbit = null; if (this.mvReady) { try { const o = this.mv.getCameraOrbit(); orbit = { theta: o.theta * 180 / Math.PI, phi: o.phi * 180 / Math.PI, radius: o.radius }; } catch (e) { orbit = null; } }
      return { open: this.openIndex >= 0, tab: this.openIndex, orbit, following: !!this.following, finish: this.finish, intro: this.introState, phone: !!this.phone, ready: !!this.ready, loaded: !!this.loaded, error: !!this.error };
    }
  }
  customElements.define('product-viewer-section', ProductViewerSection);
})();
</script>
