<script>
/* 3D product viewer section: behaviour.
 * Reproduces Apple's "Take a closer look" viewer around a live <model-viewer> (4.3.1):
 * pill stack that grows into cards with a physical spring, paddles, close button, intro,
 * phone carousel with swipe, per-tab background crossfade, camera presets, mouse-follow,
 * finishes (src swap with crossfade + prefetch), keyboard/aria, reduced motion, loading and
 * error states, theme editor events and a small public API.
 *
 * ES2019, no build step. Must never contain Liquid delimiters (double curly braces, curly-percent)
 * or a closing script tag: it is inlined into a Liquid file. Keep byte-identical to
 * backend/static/product-viewer.js (rig/check_schema.py checks).
 *
 * Config: the <product-viewer-section> root carries data-config (JSON built in Liquid):
 *   {id, theme, mvSrc, name, model:{src,poster,alt}, hero:{orbit,target,fov},
 *    background:BG, mouseFollow, followYaw, followPitch, autoRotate, allowZoom,
 *    intro, exposure, shadow, environment, showFinishes, finishesLabel,
 *    tabs:[{id,label,title,body,orbit,target,fov,background:BG,model}],
 *    finishes:[{id,label,swatch,swatchImage,model,poster,background}]}
 * where BG = {color, image, fit, imageMobile, fitMobile}: `image`/`fit` are the desktop background
 *   image and its object-fit ("cover"|"contain"); `imageMobile`/`fitMobile` are the phone ones, used
 *   at 734px and below and falling back to the desktop image when empty. fitMobile also takes "top"
 *   and "bottom" (cover, pinned to that edge). Both layers are painted and CSS picks one per width,
 *   so the phone image is right on the first paint and across a rotation without JS.
 * Pills are rendered by Liquid in DOM order: the finishes pill (index 0, when shown) then one
 * pill per feature block. openTab(i) indexes that list.
 *
 * Public API on the element: openTab(i) -> bool, close(), next(), prev(), selectFinish(i) -> bool,
 *   state() -> {open, tab, orbit:{theta,phi (deg),radius (m)}|null, following, finish, intro, phone, ready, loaded, error}
 * Events (bubble): pv:ready, pv:intro {state}, pv:open {index,id,kind}, pv:close {index},
 *   pv:finish {index,label,model}.
 * Phone framing: below 734px the camera keeps the authored angles but never comes closer than 115% of
 *   model-viewer's own fit for the current viewport (a distance in metres or a fixed field of view is
 *   replaced outright), so a camera authored on a desktop cannot crop the narrow panel. See framePreset.
 * Camera: a tab's preset is reached with the section's own spring (see applyCamera); mouse-follow adds
 *   (dx*follow_yaw, -dy*follow_pitch) to the base orbit, dy measured upward; a user drag/wheel/keyboard orbit
 *   pauses follow for USER_PAUSE after the input ends and makes the user's orbit the base until the next tab.
 *   Reduced motion: springs and camera moves are instant and mouse-follow is off (it is continuous motion).
 */
(() => {
  'use strict';
  if (customElements.get('product-viewer-section')) return;
  const MV_SRC = 'https://cdn.jsdelivr.net/npm/@google/model-viewer@4.3.1/dist/model-viewer.min.js';
  const MV_TIMEOUT = 8000;       // ms to wait for the library before falling back to the poster
  const PHONE = '(max-width: 734px)';
  const PILL = 56;               // collapsed pill height / intro circle size
  const HANDOFF = 180;           // ms: the intro circle settles to pill size and fades as the real pill takes over
  const GAP = 12;                // desktop gap between pills
  const SAFE = 40;               // desktop safe margin (Apple: panel height - 80)
  const PHONE_GAP = 10;          // phone: distance between neighbouring pills
  const PHONE_MIN_RADIUS = 115;  // phone: % of model-viewer's own fit the camera may never go inside of
  // model-viewer clamps the radius to max-camera-orbit, whose default radius is exactly 100% (its own
  // fit), so asking for 115% without raising that ceiling would be silently clamped back to 100%.
  const PHONE_MAX_ORBIT = 'auto auto ' + PHONE_MIN_RADIUS + '%';
  const MASK_FADE = 32;          // phone: px over which a pill fades out across the panel's inset gutter
  const SWIPE = 74;              // phone: px to commit a swipe
  const FLICK = 0.5;             // phone: px/ms for a quick flick (>= 16 px)
  const USER_PAUSE = 1500;       // ms follow pauses after the last user camera input
  const DECAY_IDLE = 120;        // model-viewer interpolation-decay while idle: a liquid but responsive drag
  const DECAY_FOLLOW = 120;      // mouse-follow writes
  const DECAY_BACK = 250;        // easing the follow offset back to centre when the pointer leaves
  const DECAY_MOVE = 50;         // while the section's spring drives a preset move (the camera tracks it tightly)
  const SPRING_CARD = { m: 1, k: 100, c: 14 };     // spring(1,100,14)
  const SPRING_CAMERA = { m: 1, k: 100, c: 14 };   // camera preset moves: same spring as the card, capped at 1 s
  const SPRING_CLOSE = { m: 1, k: 56, c: 10 };     // spring(1,56,10)
  const SPRING_INTRO = { m: 1.61, k: 100, c: 14 }; // spring(1.61,100,14)
  const SPRING_RING = { m: 1, k: 50, c: 10 };      // spring(1,50,10)
  const SPRING_X = { m: 1, k: 100, c: 20 };        // phone carousel x
  const SPRING_W = { m: 1, k: 100, c: 10 };        // phone card width
  const SPRING_H = { m: 1, k: 157.9, c: 14.6 };    // phone card height (duration .5 s, bounce .42)
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  // Newton-solved cubic-bezier, so the two curves Apple names in ANIM_CONSTANTS are the curves we run and
  // not an approximation of them: easeIn cubic-bezier(0.42, 0, 1, 1) and easeBoth cubic-bezier(0.42, 0, 0.58, 1).
  const bezier = (x1, y1, x2, y2) => {
    const A = (a, b) => 1 - 3 * b + 3 * a, B = (a, b) => 3 * b - 6 * a, C = a => 3 * a;
    const at = (t, a, b) => ((A(a, b) * t + B(a, b)) * t + C(a)) * t;
    const slope = (t, a, b) => 3 * A(a, b) * t * t + 2 * B(a, b) * t + C(a);
    return t => {
      if (t <= 0 || t >= 1) return t;
      let g = t;
      for (let i = 0; i < 8; i++) { const d = slope(g, x1, x2); if (!d) break; const x = at(g, x1, x2) - t; if (Math.abs(x) < 1e-6) break; g -= x / d; }
      return at(g, y1, y2);
    };
  };
  const EASE = {
    linear: t => t,
    easeOutQuart: t => 1 - Math.pow(1 - t, 4),
    easeInQuad: t => t * t,
    easeInOutCubic: t => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2,
    easeIn: bezier(0.42, 0, 1, 1),
    easeBoth: bezier(0.42, 0, 0.58, 1),
  };
  const prefetched = new Set();

  /* ---- animation engine: one rAF loop, springs (semi-implicit Euler, sub-stepped) and eases ---- */
  const running = new Set();
  let frame = 0;
  const loop = now => { frame = 0; for (const a of Array.from(running)) a.step(now); if (running.size) frame = requestAnimationFrame(loop); };
  const schedule = () => { if (!frame && running.size) frame = requestAnimationFrame(loop); };
  class Tween {
    // o: {from, to, update(v), done(), delay, duration (ms; cap for springs), spring{m,k,c} | ease, eps, instant, velocity}
    constructor(o) {
      Object.assign(this, o); this.x = o.from; this.v = o.velocity || 0; this.t0 = 0; this.tPrev = 0;
      this.eps = o.eps || 0.05; this.duration = o.duration || 1000; this.ease = o.ease || EASE.easeOutQuart;
      if (o.instant) { this.finish(); return; }
      running.add(this); schedule();
    }
    step(now) {
      if (!this.t0) { this.t0 = now + (this.delay || 0); this.tPrev = this.t0; }
      if (now < this.t0) return;
      const elapsed = now - this.t0;
      if (this.spring) {
        let dt = Math.min(now - this.tPrev, 250) / 1000; this.tPrev = now;   // integrate the real elapsed time (slow frames must not slow the spring)
        const s = this.spring;
        while (dt > 0) { const h = Math.min(dt, 1 / 240); const a = (-s.k * (this.x - this.to) - s.c * this.v) / s.m; this.v += a * h; this.x += this.v * h; dt -= h; }
        if ((Math.abs(this.x - this.to) < this.eps && Math.abs(this.v) < this.eps * 20) || elapsed >= this.duration) this.finish(); else this.update(this.x);
      } else {
        const p = Math.min(1, elapsed / this.duration);
        this.x = this.from + (this.to - this.from) * this.ease(p);
        if (p >= 1) this.finish(); else this.update(this.x);
