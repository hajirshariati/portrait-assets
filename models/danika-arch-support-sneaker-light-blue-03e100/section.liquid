{%- comment -%}
  3D product viewer ("Take a closer look" style viewer around a live <model-viewer>).

  Two ways to install this section:
    1. Single file (what the admin's "Download section file" and `python3 shopify/build_section.py --product`
       produce): product-viewer.css and product-viewer.js are inlined where the PV_INLINE_CSS / PV_INLINE_JS
       markers sit below and the PV_ASSETS block is removed. Paste it as sections/product-viewer.liquid.
    2. Theme assets (this repo variant): copy product-viewer.css and product-viewer.js into assets/ and paste
       this file unchanged; the asset_url tags in the PV_ASSETS block load them and the marker elements stay empty.
  model-viewer 4.3.1 is loaded once per page from jsDelivr by product-viewer.js unless a <model-viewer>
  element is already defined (Shopify's own copy) or the "mv_src" setting points at a theme asset.
  Do not edit the markers: the backend replaces them (and the single preset in the schema) per product.
{%- endcomment -%}
<style>
/* 3D product viewer section: styles.
 * Reproduces Apple's "Take a closer look" viewer (pill stack, expanding cards, paddles, close
 * button, phone carousel) around a live <model-viewer>. Values are Apple's (dark theme); the
 * light theme swaps the colour tokens. Every colour/size the theme editor can change arrives as
 * a CSS custom property on the <product-viewer-section> root (set from Liquid) so the tokens
 * map 1:1 to settings. Inlined into product-viewer.liquid by build_section.py (PV_INLINE_CSS)
 * or loaded as a theme asset; it must never contain Liquid delimiters (Liquid would parse them).
 * Keep this file byte-identical to backend/static/product-viewer.css (rig/check_schema.py).
 *
 * Colour scoping: the panel's own palette lives on .pv-panel, not on the custom element, because
 * the headline sits OUTSIDE the panel on the merchant's page and must read against that page.
 */
product-viewer-section {
  /* layout tokens (panel colours are scoped to .pv-panel below) */
  --pv-bg: #000;
  --pv-max-width: 1440px;
  --pv-height: 760px;
  --pv-height-mobile: 640px;
  --pv-radius: 28px;
  --pv-inset: 6.25vw;            /* phone: how far the visual panel is inset from each screen edge (Apple) */
  --pv-blur: 20px;
  --pv-expanded: 423px;
  --pv-fade: 500ms;
  --pv-gutter: min(90px, 6.25vw);
  --pv-focus: #0071e3;
  --pv-font-text: "SF Pro Text", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --pv-font-display: "SF Pro Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
  display: block;
  position: relative;
  font-family: var(--pv-font-text);
  -webkit-font-smoothing: antialiased;
}
/* Panel palette. Scoped here so nothing outside the panel (the headline) inherits it. */
.pv-panel {
  --pv-text: rgb(245, 245, 247);
  --pv-pill: rgb(42 42 45 / 0.72);
  --pv-pill-hover: rgb(42 42 45 / 0.92);
  --pv-pill-solid: rgb(42, 42, 45);
  --pv-icon: #f4f4f7;
  --pv-disabled: 0.36;
  --pv-progress: rgb(245 245 247 / 0.6);
  --pv-scrim: 0 0 0;             /* scrim veil colour, shown only over a background image */
  color: var(--pv-text);
}
product-viewer-section.pv--light .pv-panel {
  --pv-text: rgb(29, 29, 31);
  --pv-pill: rgb(232 232 237 / 0.72);
  --pv-pill-hover: rgb(232 232 237 / 0.92);
  --pv-pill-solid: rgb(232, 232, 237);
  --pv-icon: #1d1d1f;
  --pv-disabled: 0.42;
  --pv-progress: rgb(29 29 31 / 0.5);
  --pv-scrim: 245 245 247;
}
product-viewer-section *, product-viewer-section *::before, product-viewer-section *::after { box-sizing: border-box; }
product-viewer-section button { font: inherit; color: inherit; background: none; border: 0; margin: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
product-viewer-section button:focus { outline: none; }
product-viewer-section button:focus-visible, product-viewer-section .pv-swatch-input:focus-visible + .pv-swatch-link { outline: 2px solid var(--pv-focus); outline-offset: 1px; }
.pv-sr { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

/* ---- headline (outside the panel, on the merchant's page) ---- */
.pv-head { max-width: var(--pv-max-width); margin: 0 auto; padding: 0 min(90px, 6.25vw) 40px; }
/* No colour of our own by default: the theme's text colour wins, and the "Heading colour" setting
   sets --pv-heading-color inline when the merchant picks one. */
.pv-headline { margin: 0; font-family: var(--pv-font-display); font-size: 48px; line-height: 1.0834933333; font-weight: 600; letter-spacing: -0.003em; color: var(--pv-heading-color, inherit); }

/* ---- panel ---- */
.pv-panel {
  position: relative; width: 100%; max-width: var(--pv-max-width); height: var(--pv-height);
  margin: 0 auto; overflow: hidden; background: var(--pv-bg); outline: none;
}
.pv-panel:focus-visible { outline: 2px solid var(--pv-focus); outline-offset: -2px; }
@media (min-width: 1441px) { .pv-panel { border-radius: var(--pv-radius); } }
@media (max-width: 1068px) { product-viewer-section { --pv-expanded: 374px; } .pv-panel { height: calc(var(--pv-height) - 40px); } .pv-headline { font-size: 40px; line-height: 1.1; letter-spacing: 0; } }
@media (max-width: 734px) {
  /* Card and its paddles are laid out inside the INSET panel (Apple measures from the viewport, but
     Apple's page is the same colour as its panel; ours is not), so the chevrons land on the panel. */
  product-viewer-section { --pv-expanded: min(calc(100vw - 2 * var(--pv-inset) - 80px), 400px); padding-block-start: 24px; }
  .pv-head { padding-bottom: 28px; }
  .pv-headline { font-size: 32px; line-height: 1.125; letter-spacing: 0.004em; }
  .pv-panel { height: var(--pv-height-mobile); }
}

/* ---- model layer ---- */
.pv-stage { position: absolute; inset: 0; z-index: 1; }
.pv-bg, .pv-bg-next { position: absolute; inset: 0; background: var(--pv-bg); overflow: hidden; }
.pv-bg-next { opacity: 0; transition: opacity 400ms ease-in-out; }
.pv-bg-next.is-in { opacity: 1; }
.pv-bg-next.no-anim { transition: none; }
.pv-bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.pv-bg-img.fit-contain { object-fit: contain; }
.pv-bg-img.fit-top { object-position: 50% 0; }
.pv-bg-img.fit-bottom { object-position: 50% 100%; }
/* The phone image is only painted below the breakpoint, and only then does it replace the desktop
   one (a layer without a phone image keeps showing the desktop image at every width). */
.pv-bg-img--mobile { display: none; }
@media (max-width: 734px) { .pv-bg-img--mobile { display: block; } .pv-bg--dual .pv-bg-img--desktop { display: none; } }
.pv-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: block; pointer-events: none; }
.pv-mv {
  position: absolute; inset: 0; width: 100%; height: 100%; background: transparent; z-index: 1;
  pointer-events: auto; --progress-bar-height: 0px; --progress-bar-color: transparent;
}
.pv-mv::part(default-progress-bar) { display: none; }
.pv-snap { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; object-fit: fill; opacity: 1; transition: opacity var(--pv-fade) ease-in-out; }
.pv-snap.is-out { opacity: 0; }
.pv-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; z-index: 2; pointer-events: none; opacity: 0; transition: opacity 300ms ease-in-out; }
.pv-progress.is-on { opacity: 1; }
.pv-progress-bar { width: 100%; height: 100%; background: var(--pv-progress); transform-origin: left center; transition: transform 200ms ease-out; transform: scaleX(0); }
.pv-error { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2; padding: 12px 20px; border-radius: 28px; background: var(--pv-pill); backdrop-filter: blur(var(--pv-blur)); -webkit-backdrop-filter: blur(var(--pv-blur)); font-size: 17px; font-weight: 600; letter-spacing: -0.022em; pointer-events: none; }

/* ---- controls overlay (Apple's all-access-pass) ---- */
.pv-aap { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
/* Scrim: only ever shown when a background image is in use (JS adds .is-on), so a plain colour
   background is never muddied. It sits under the controls and over the model, which is the only
   place it has to work: it is what keeps the pill and card text readable over a busy photo. */
.pv-scrim {
  position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 400ms ease-in-out;
  background: linear-gradient(to right, rgb(var(--pv-scrim) / 0.55) 0, rgb(var(--pv-scrim) / 0.3) 26%, rgb(var(--pv-scrim) / 0) 52%);
}
.pv-scrim.is-on { opacity: 1; }
.pv-scrim.no-anim { transition: none; }
.pv-controls {
  position: absolute; left: var(--pv-gutter); top: 50%; transform: translateY(-50%);
  width: fit-content; pointer-events: none;
}
.pv-group { display: flex; flex-direction: column; flex-wrap: nowrap; gap: 12px; justify-content: center; min-width: fit-content; margin: 0; padding: 0; list-style: none; overflow: visible; }

/* pill (li) : the same element grows into the card */
.pv-item {
  position: relative; display: flex; align-items: flex-start; justify-content: flex-start;
  width: fit-content; height: 56px; flex-shrink: 0; border-radius: var(--pv-radius);
  backdrop-filter: blur(var(--pv-blur)); -webkit-backdrop-filter: blur(var(--pv-blur));
  pointer-events: auto; list-style: none;
}
.pv-item-bg-wrap { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.pv-item-bg-wrap.grow-right { justify-content: flex-start; }
.pv-item-bg {
  position: absolute; display: block; width: 100%; height: 100%; border-radius: var(--pv-radius);
  background-color: var(--pv-pill); box-shadow: inset 0 0 .5px 0 rgba(0, 0, 0, .11);
  transform-origin: bottom center; transition: background-color 250ms linear;
}
@media (hover: hover) { .pv-item:not(.is-expanded):hover .pv-item-bg { background-color: var(--pv-pill-hover); } }
.pv-open {
  position: relative; display: flex; align-items: center; justify-content: center;
  height: 56px; width: auto; padding: 0 32px 0 14px; white-space: nowrap; border-radius: var(--pv-radius);
  opacity: 1; transition: opacity 400ms ease-in-out 350ms;
}
.pv-item.is-expanded { z-index: 2; }   /* the card (and its phone gutter paddles) paints above the neighbouring pills */
.pv-item.is-expanded .pv-open { opacity: 0; pointer-events: none; transition: opacity 50ms ease-in-out 0ms; }
.pv-label { display: flex; align-items: center; color: var(--pv-text); white-space: nowrap; font-size: 17px; line-height: 1.2353641176; font-weight: 600; letter-spacing: -0.022em; }
.pv-label > .pv-icon, .pv-label > .pv-swatch { margin-inline-end: 14px; flex-shrink: 0; }
.pv-icon { width: 24px; height: 24px; display: block; }
.pv-icon circle { stroke: var(--pv-icon); fill: none; stroke-width: 1; }
.pv-icon path { fill: var(--pv-icon); }
.pv-swatch { display: inline-block; width: 24px; height: 24px; border-radius: 50%; background: var(--pv-swatch, #888) 50% / 100% no-repeat; line-height: 0; color: transparent; user-select: none; }

/* card content */
.pv-content { position: absolute; top: 0; left: 0; width: 100%; height: 100%; padding: 0; color: var(--pv-text); pointer-events: none; }
.pv-content-mask { display: flex; flex-direction: column; width: calc(100% + .5px); height: calc(100% + .5px); border-radius: var(--pv-radius); overflow: hidden; }
.pv-content-inner {
  display: flex; flex-direction: column; flex-shrink: 0; width: max-content; max-width: var(--pv-expanded); padding: 28px;
  opacity: 0; visibility: hidden; transform: translateY(28px);
  transition: opacity 300ms ease-in-out 0ms, visibility 300ms ease-in-out 0ms, transform 400ms ease-in-out 0ms;
}
.pv-item.is-expanded .pv-content-inner { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; transition: opacity 600ms ease-in-out 250ms, transform 400ms ease-in-out 0ms; }
.pv-body { margin: 0; font-size: 17px; line-height: 1.4705882353; font-weight: 400; letter-spacing: -0.022em; }
.pv-title { font-weight: 600; }
.pv-colornav { display: inline-flex; justify-content: center; margin: 0; padding: 0; border: 0; min-width: 0; }
.pv-swatches { display: flex; flex-wrap: wrap; justify-content: center; row-gap: 8px; margin: 0; padding: 18px 0 0; list-style: none; }
.pv-swatch-item { margin: -1px 4px; }
.pv-swatch-input { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); opacity: 0; }
.pv-swatch-link { position: relative; z-index: 1; display: inline-flex; width: 32px; height: 32px; padding: 2px; border: 2px solid transparent; border-radius: 50%; cursor: pointer; }
.pv-swatch-input:checked + .pv-swatch-link { border-color: var(--pv-text); cursor: default; pointer-events: none; }
.pv-swatch-link .pv-swatch { display: block; }

/* desktop paddles (in the gutter left of the pills) and close button */
.pv-paddles {
  position: absolute; top: 0; left: calc(-1 * var(--pv-gutter)); width: var(--pv-gutter); height: 100%;
  display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 20px; margin: 0;
  transform: scale(0) translateY(120px); visibility: hidden; pointer-events: none;
}
.pv-paddles.is-visible { visibility: visible; }
.pv-paddle { display: grid; place-content: center; width: 44px; height: 44px; border-radius: 22px; pointer-events: auto; touch-action: manipulation; }
.pv-paddle:disabled { pointer-events: none; opacity: var(--pv-disabled); }
.pv-paddle-icon { position: relative; display: flex; align-items: center; width: 36px; height: 36px; border-radius: 50%; background-color: var(--pv-pill); backdrop-filter: blur(var(--pv-blur)); -webkit-backdrop-filter: blur(var(--pv-blur)); transition: background-color 250ms linear; }
.pv-paddle-icon svg, .pv-close-icon svg { width: 100%; height: 100%; display: block; fill: var(--pv-text); }
@media (hover: hover) { .pv-paddle:hover .pv-paddle-icon, .pv-close:hover .pv-close-icon { background-color: var(--pv-pill-hover); } }
.pv-nav { display: none; }
.pv-close-wrap { position: absolute; inset: 0; display: flex; pointer-events: none; }
.pv-close {
  position: absolute; top: 16px; right: 16px; z-index: 1; display: grid; place-content: center; width: 44px; height: 44px;
  border-radius: 22px; pointer-events: auto; visibility: hidden; transform: scale(0) translateY(120px);
}
.pv-close.is-visible { visibility: visible; }
.pv-close-icon { width: 36px; height: 36px; border-radius: 50%; background-color: var(--pv-pill); backdrop-filter: blur(var(--pv-blur)); -webkit-backdrop-filter: blur(var(--pv-blur)); box-shadow: inset 0 0 .5px 0 rgba(0, 0, 0, .11); transition: background-color 250ms linear; }

/* Intro element: the circle that arrives from the left and becomes the middle pill. Apple's own rule, value
   for value - a solid beat colour (not the pills' translucent one), 56px, radius 56px, and a ::before of the
   same colour scaled by --pe-scale. It is shown with display:block for the intro and hidden outright the
   moment the middle pill draws its own background. */
.pv-intro { --pe-scale: 0; position: absolute; left: 0; top: 0; width: 56px; height: 56px; border-radius: 56px; box-sizing: border-box; background-color: var(--pv-pill-solid); transform: translateX(-100px) scale(0); opacity: 0; pointer-events: none; display: none; will-change: opacity, transform; }
.pv-intro.is-on { display: block; }
.pv-intro::before { content: ""; position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 56px; background-color: var(--pv-pill-solid); transform: scale(var(--pe-scale)); }
product-viewer-section.is-intro .pv-item-bg, product-viewer-section.is-intro .pv-label { opacity: 0; }
product-viewer-section.is-intro .pv-controls { pointer-events: none; }
product-viewer-section.is-intro .pv-item { pointer-events: none; }

/* ---- phone (<= 734px): horizontal carousel pinned to the bottom of the panel ---- */
@media (max-width: 734px) {
  /* Apple: the component is transparent and full width; the inset, rounded, clipped box is the inner container.
     Here .pv-stage (background + model) is inset --pv-inset and the controls overlay keeps the full width, so the
     carousel gutters and their paddles are not clipped by the rounded panel. */
  .pv-panel { width: 100%; margin: 0; background: transparent; overflow: visible; border-radius: 0; }
  .pv-stage { left: var(--pv-inset); right: var(--pv-inset); border-radius: var(--pv-radius); overflow: hidden; background: var(--pv-bg); }
  .pv-scrim {
    left: var(--pv-inset); right: var(--pv-inset); border-radius: var(--pv-radius);
    background: linear-gradient(to top, rgb(var(--pv-scrim) / 0.62) 0, rgb(var(--pv-scrim) / 0.34) 140px, rgb(var(--pv-scrim) / 0) 290px);
  }
  .pv-aap { display: flex; flex-direction: column; justify-content: flex-end; overflow: clip; }
  .pv-controls {
    position: sticky; left: 0; top: auto; bottom: 0; transform: none; width: 100%; height: 152px; padding-bottom: 20px;
    margin-top: -20px; display: flex; flex-direction: column; justify-content: flex-end; overflow: clip; pointer-events: auto;
    touch-action: pan-y;
  }
  .pv-group { position: relative; flex-direction: row; align-items: flex-end; height: 56px; width: 100%; gap: 0; }
  .pv-item { position: absolute; left: 0; bottom: 0; min-height: 36px; min-width: 40px; backdrop-filter: none; -webkit-backdrop-filter: none; --pv-m0: -9999px; --pv-m1: -9999px; --pv-m2: 9999px; --pv-m3: 9999px; }
  /* A pill that runs past the inset panel would show the panel's own rounded edge through its translucent
     surface and read as a severed pill, so the surface and the label fade out across the panel's gutter
     instead: the neighbour peeks and dissolves at the edge. JS writes the four stops per pill (setMask).
     The blur moves onto the surface (Apple does the same at this breakpoint) so it is masked with it. */
  .pv-item-bg { backdrop-filter: blur(var(--pv-blur)); -webkit-backdrop-filter: blur(var(--pv-blur)); }
  .pv-item-bg, .pv-open {
    -webkit-mask-image: linear-gradient(90deg, transparent var(--pv-m0), #000 var(--pv-m1), #000 var(--pv-m2), transparent var(--pv-m3));
    mask-image: linear-gradient(90deg, transparent var(--pv-m0), #000 var(--pv-m1), #000 var(--pv-m2), transparent var(--pv-m3));
  }
  .pv-open { padding: 0 32px 0 16px; }
  .pv-label { font-size: 14px; line-height: 1.2857742857; letter-spacing: -0.016em; }
  .pv-label > .pv-swatch { margin-inline-end: 19px; }
  .pv-content-inner { padding: 24px; transform: translateY(24px); transition: transform 300ms ease-out, opacity 200ms ease-out; }
  .pv-item.is-expanded .pv-content-inner { transition: transform 420ms ease-out, opacity 420ms ease-out 200ms; }
  .pv-body { font-size: 14px; line-height: 1.4285914286; letter-spacing: -0.016em; }
  .pv-swatches { max-width: 170px; padding-top: 14px; }
  .pv-paddles { display: none; }
  .pv-nav { display: block; position: absolute; left: 0; bottom: 0; width: 100%; height: 88px; pointer-events: none; opacity: 0; visibility: hidden; transition: opacity 300ms ease-out, visibility 300ms; }
  .pv-item.is-expanded .pv-nav { opacity: 1; visibility: visible; }
  /* The gutter between the card and the panel edge, so the bare chevrons sit on the panel background. */
  .pv-nav .pv-paddle { position: absolute; bottom: 0; width: calc((100vw - var(--pv-expanded)) / 2 - var(--pv-inset)); height: 88px; border-radius: 0; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 10px; }
  .pv-nav .pv-paddle--prev { right: 100%; }
  .pv-nav .pv-paddle--next { left: 100%; }
  .pv-nav .pv-paddle:disabled { display: none; }
  .pv-nav .pv-paddle-icon { background: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .pv-close { top: 20px; right: calc(var(--pv-inset) + 20px); width: 36px; height: 36px; border-radius: 18px; }
  .pv-close-icon { width: 36px; height: 36px; }
  .pv-error { font-size: 14px; }
}

/* ---- reduced motion: springs are snapped in JS; CSS transitions collapse to 0 ---- */
@media (prefers-reduced-motion: reduce) {
  .pv-open, .pv-item.is-expanded .pv-open, .pv-content-inner, .pv-item.is-expanded .pv-content-inner, .pv-bg-next, .pv-snap, .pv-nav, .pv-scrim { transition-duration: 0ms !important; transition-delay: 0ms !important; }
}
</style>
{%- liquid
  assign s = section.settings
  assign model_url = s.model_url | default: '' | strip
  assign poster_url = s.poster_url | default: '' | strip
  assign model_alt = s.model_alt | default: '3D model'
  assign product_name = s.product_name | default: '' | strip
  assign hero_orbit = s.hero_orbit | default: '' | strip
  assign hero_target = s.hero_target | default: '' | strip
  assign hero_fov = s.hero_fov | default: '' | strip
  assign bg_color = s.background | append: ''
  assign bg_image = ''
  if s.background_image != blank
    assign bg_image = s.background_image | image_url: width: 2000
  endif
  assign bg_image_mobile = ''
  if s.background_image_mobile != blank
    assign bg_image_mobile = s.background_image_mobile | image_url: width: 1400
  endif
  assign bg_fit_class = ''
  if s.background_image_fit == 'contain'
    assign bg_fit_class = ' fit-contain'
  endif
  assign bg_fit_mobile_class = ''
  if s.background_image_mobile_fit != 'cover' and s.background_image_mobile_fit != blank
    assign bg_fit_mobile_class = s.background_image_mobile_fit | prepend: ' fit-'
  endif
  assign bg_dual = false
  if bg_image != blank and bg_image_mobile != blank
    assign bg_dual = true
  endif
  assign finish_count = 0
  assign feature_count = 0
  for block in section.blocks
    if block.type == 'finish'
      assign finish_count = finish_count | plus: 1
    elsif block.type == 'feature'
      assign feature_count = feature_count | plus: 1
    endif
  endfor
  assign has_finishes = false
  if s.show_finishes and finish_count > 0
    assign has_finishes = true
  endif
  assign theme = s.theme | default: 'dark'
-%}
{%- capture config -%}
{
  "id": {{ section.id | json }},
  "theme": {{ theme | json }},
  "mvSrc": {{ s.mv_src | default: '' | strip | json }},
  "name": {{ product_name | json }},
  "model": {"src": {{ model_url | json }}, "poster": {{ poster_url | json }}, "alt": {{ model_alt | json }}},
  "hero": {"orbit": {{ hero_orbit | json }}, "target": {{ hero_target | json }}, "fov": {{ hero_fov | json }}},
  "background": {"color": {{ bg_color | json }}, "image": {{ bg_image | json }}, "fit": {{ s.background_image_fit | default: 'cover' | json }}, "imageMobile": {{ bg_image_mobile | json }}, "fitMobile": {{ s.background_image_mobile_fit | default: 'cover' | json }}},
  "mouseFollow": {{ s.mouse_follow | json }}, "followYaw": {{ s.follow_yaw | json }}, "followPitch": {{ s.follow_pitch | json }},
  "autoRotate": {{ s.auto_rotate | json }}, "allowZoom": {{ s.allow_zoom | json }}, "intro": {{ s.intro_animation | json }},
  "exposure": {{ s.exposure | json }}, "shadow": {{ s.shadow | json }}, "environment": {{ s.environment | default: 'studio' | json }},
  "showFinishes": {{ has_finishes | json }}, "finishesLabel": {{ s.finishes_label | default: 'Finishes' | json }},
  "tabs": [
  {%- assign n = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'feature' -%}
      {%- if n > 0 -%},{%- endif -%}{%- assign n = n | plus: 1 -%}
      {%- assign tab_bg_image = '' -%}
      {%- if block.settings.background_image != blank -%}{%- assign tab_bg_image = block.settings.background_image | image_url: width: 2000 -%}{%- endif -%}
      {%- assign tab_bg_image_mobile = '' -%}
      {%- if block.settings.background_image_mobile != blank -%}{%- assign tab_bg_image_mobile = block.settings.background_image_mobile | image_url: width: 1400 -%}{%- endif -%}
      {"id": {{ block.id | json }}, "label": {{ block.settings.label | default: '' | json }}, "title": {{ block.settings.title | default: '' | json }}, "body": {{ block.settings.body | default: '' | json }},
       "orbit": {{ block.settings.orbit | default: '' | strip | json }}, "target": {{ block.settings.target | default: '' | strip | json }}, "fov": {{ block.settings.fov | default: '' | strip | json }},
       "background": {"color": {{ block.settings.background | append: '' | json }}, "image": {{ tab_bg_image | json }}, "fit": {{ block.settings.background_image_fit | default: 'cover' | json }}, "imageMobile": {{ tab_bg_image_mobile | json }}, "fitMobile": {{ block.settings.background_image_mobile_fit | default: 'cover' | json }}},
       "model": {{ block.settings.model_url_override | default: '' | strip | json }}}
    {%- endif -%}
  {%- endfor -%}
  ],
  "finishes": [
  {%- assign n = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'finish' -%}
      {%- if n > 0 -%},{%- endif -%}{%- assign n = n | plus: 1 -%}
      {%- assign swatch_image = '' -%}
      {%- if block.settings.swatch_image != blank -%}{%- assign swatch_image = block.settings.swatch_image | image_url: width: 96 -%}{%- endif -%}
      {"id": {{ block.id | json }}, "label": {{ block.settings.label | default: '' | json }}, "swatch": {{ block.settings.swatch_color | append: '' | json }}, "swatchImage": {{ swatch_image | json }},
       "model": {{ block.settings.model_url | default: '' | strip | json }}, "poster": {{ block.settings.poster_url | default: '' | strip | json }}, "background": {{ block.settings.background | append: '' | json }}}
    {%- endif -%}
  {%- endfor -%}
  ]
}
{%- endcapture -%}
<product-viewer-section id="pv-{{ section.id }}" class="pv pv--{{ theme }}" data-section-id="{{ section.id }}" data-config='{{ config | escape }}'
  style="--pv-bg:{{ bg_color | default: '#000000' }};--pv-max-width:{{ s.max_width }}px;--pv-height:{{ s.height_desktop }}px;--pv-height-mobile:{{ s.height_mobile }}px;--pv-radius:{{ s.radius }}px;{% if s.heading_color != blank and s.heading_color.alpha != 0 %}--pv-heading-color:{{ s.heading_color }};{% endif %}">
