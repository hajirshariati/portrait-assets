      this.classList.add('is-intro');
      this.introObserver = new IntersectionObserver(entries => {
        for (const en of entries) {
          const need = Math.min(0.6 * en.boundingClientRect.height, 0.8 * (window.innerHeight || 800));
          if (en.isIntersecting && en.intersectionRect.height >= need && this.introState === 'pending') { this.introObserver.disconnect(); this.runIntro(); }
        }
