      const active = this.querySelector('.pv-swatch--active'); if (active) active.style.setProperty('--pv-swatch', f.swatchImage ? 'url(' + f.swatchImage + ')' : (f.swatch || '#888'));
      const cur = this.querySelector('.pv-finish-current'); if (cur) cur.textContent = f.label || '';
