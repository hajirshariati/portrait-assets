        loading="lazy" reveal="auto" camera-controls touch-action="pan-y" disable-pan disable-tap{% unless s.allow_zoom %} disable-zoom{% endunless %} interaction-prompt="none"
        {%- if hero_orbit != blank %} camera-orbit="{{ hero_orbit | escape }}"{% endif %}{% if hero_target != blank %} camera-target="{{ hero_target | escape }}"{% endif %}{% if hero_fov != blank %} field-of-view="{{ hero_fov | escape }}"{% endif %}
